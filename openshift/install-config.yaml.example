# OpenShift SNO install-config.yaml example for Azure IPI
# Target: Red Hat OpenShift Container Platform 4.20 (stable-4.20 / 4.20.32)
#
# DO NOT USE THIS FILE DIRECTLY.
# Generate the real install-config.yaml using:
#   ./scripts/02-create-install-config.sh
#
# The real install-config.yaml:
#   - contains your pull secret and SSH key (sensitive)
#   - is consumed and deleted by openshift-install during installation
#   - is gitignored and must never be committed
#
# Field reference:
#   https://docs.redhat.com/en/documentation/openshift_container_platform/4.20/html/installing_on_azure/installation-config-parameters-azure
#
# IMPORTANT — VM SKU selection for this subscription:
#   Standard_D8s_v3 is NotAvailableForSubscription in eastus2.
#   Standard_D8s_v7 (Intel, Dsv7 family) is unrestricted, 8 vCPU, 32 GB, Premium SSD.
#   Dsv7 quota in eastus2: 25 vCPU (sufficient for bootstrap 8 + SNO 8 = 16 peak).
#   defaultMachinePlatform.type is set to Standard_D8s_v7 to override the installer's
#   built-in bootstrap default (Standard_D8s_v3), which would fail for this subscription.

apiVersion: v1

# The base domain must match the Azure DNS zone created by Terraform.
# Replace labX with your lab number (e.g. lab1).
baseDomain: ocplab1.arunkube.org

metadata:
  # Cluster name. Combined with baseDomain to form the cluster FQDN:
  #   api.sno.ocplab1.arunkube.org
  #   *.apps.sno.ocplab1.arunkube.org
  # Restrictions: do not use 'windows', 'microsoft', or start with 'login'.
  name: sno

# SNO: exactly 1 control plane replica.
controlPlane:
  hyperthreading: Enabled
  name: master
  platform:
    azure:
      type: Standard_D8s_v7        # 8 vCPU, 32 GB RAM, Premium SSD (Dsv7 family)
      osDisk:
        diskSizeGB: 128            # SNO minimum is 120 GB; override the 1024 GB default.
        diskType: Premium_LRS      # Required: must be Premium_LRS for OpenShift.
  replicas: 1                      # SNO: must be 1.

# SNO: exactly 0 compute replicas.
# Setting replicas: 0 makes the control plane node schedulable for workloads.
compute:
- hyperthreading: Enabled
  name: worker
  platform:
    azure:
      type: Standard_D8s_v7        # Not used (replicas: 0), but field is required.
  replicas: 0                      # SNO: must be 0.

networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  machineNetwork:
  - cidr: 10.0.0.0/16
  # OVNKubernetes is REQUIRED for SNO. OpenShiftSDN is not supported on SNO.
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16

platform:
  azure:
    # Resource group containing the Azure DNS zone (created by Terraform).
    # Must match dns_resource_group_name in terraform.tfvars.
    baseDomainResourceGroupName: sno-dns-rg

    # Azure region.
    region: eastus2

    # CRITICAL: Override the installer's default bootstrap VM type.
    # Without this, the installer uses Standard_D8s_v3 for bootstrap, which is
    # NotAvailableForSubscription in this environment.
    # Setting defaultMachinePlatform.type applies to both bootstrap and any
    # machines not overridden by controlPlane/compute platform stanzas.
    #
    # Do NOT set identity.type: None for this lab. Default managed identity is
    # required so future ACR pull/mirror integration can use Azure identity.
    # Requires the installer SP to have User Access Administrator.
    defaultMachinePlatform:
      type: Standard_D8s_v7

# Pull secret from https://console.redhat.com/openshift/install/pull-secret
# NEVER commit the real pull secret. The script injects it from $PULL_SECRET.
pullSecret: 'PLACEHOLDER - injected by 02-create-install-config.sh'

# SSH public key for RHCOS node access (troubleshooting only).
# NEVER commit the private key. The script reads from $SSH_PUBLIC_KEY_PATH.
sshKey: 'PLACEHOLDER - injected by 02-create-install-config.sh'
